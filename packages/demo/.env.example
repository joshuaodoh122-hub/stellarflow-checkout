# StellarFlow Demo — environment configuration
# Copy this file to .env and fill in your values.
# DO NOT commit .env to version control.

# ─── Network ──────────────────────────────────────────────────────────────────
# IMPORTANT: Testnet is the default. Mainnet requires an explicit opt-in.
# To switch to mainnet, change this to 'mainnet' AND ensure your
# MERCHANT_ADDRESS is funded on mainnet. You accept full responsibility
# for mainnet transactions — there is no undo.
STELLAR_NETWORK=testnet

# ─── Merchant wallet ──────────────────────────────────────────────────────────
# Your Stellar public key (G...) — funds go directly here, never to StellarFlow.
# On testnet, get a free funded account at https://laboratory.stellar.org/#account-creator
MERCHANT_ADDRESS=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
ORIGIN_DOMAIN=localhost:3000

# ─── Price quoting ────────────────────────────────────────────────────────────
# Quote TTL in milliseconds. Default: 180000 (3 minutes).
# Decrease for high-volatility environments; increase for UX.
QUOTE_TTL_MS=180000

# ─── Horizon cursor persistence ───────────────────────────────────────────────
# Path to the file where the Horizon SSE cursor is persisted across restarts.
# The cursor ensures payments that arrive during server downtime are not missed.
# Default: horizon-cursor.txt in the project root.
# For production deployments, point this to a persistent volume (e.g. /var/data/horizon-cursor.txt on Render).
# CURSOR_FILE=./horizon-cursor.txt

# ─── Soroban escrow checkout (optional) ───────────────────────────────────────
# To enable the Soroban escrow checkout mode, deploy the escrow contract to testnet
# (see contracts/escrow/DEPLOY.md) and set both variables below.
# If either is unset, all /api/escrow/* routes return 503 "escrow not configured".
#
# ESCROW_CONTRACT_ID — the deployed escrow contract address (C...)
# ESCROW_CONTRACT_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
#
# SOROBAN_RPC_URL — Soroban RPC endpoint (defaults to Stellar testnet if unset)
# SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# ─── API key guards (optional) ────────────────────────────────────────────────
# RELEASE_API_KEY — Bearer token required on POST /api/escrow/:id/release and
# POST /api/escrow/:id/release/submit. Leave unset in local dev.
# In production (NODE_ENV=production) this MUST be set; release and refund
# endpoints return 503 when it is unset in production.
# RELEASE_API_KEY=your-secret-release-key-here
#
# SESSIONS_API_KEY — Bearer token required on GET /api/sessions.
# Leave unset to keep the endpoint open (dev only).
# SESSIONS_API_KEY=your-secret-sessions-key-here
