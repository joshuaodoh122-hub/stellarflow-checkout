# StellarFlow Demo — environment configuration
# Copy this file to .env and fill in your values.
# DO NOT commit .env to version control.

# ─── Network ──────────────────────────────────────────────────────────────────
# IMPORTANT: Testnet is the default. Mainnet requires an explicit opt-in.
# To switch to mainnet, change this to 'mainnet' AND ensure your
# MERCHANT_ADDRESS is funded on mainnet. You accept full responsibility
# for mainnet transactions — there is no undo.
STELLAR_NETWORK=testnet

# ─── Merchant wallet ──────────────────────────────────────────────────────────
# Your Stellar public key (G...) — funds go directly here, never to StellarFlow.
# On testnet, get a free funded account at https://laboratory.stellar.org/#account-creator
MERCHANT_ADDRESS=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
ORIGIN_DOMAIN=localhost:3000

# ─── Price quoting ────────────────────────────────────────────────────────────
# Quote TTL in milliseconds. Default: 180000 (3 minutes).
# Decrease for high-volatility environments; increase for UX.
QUOTE_TTL_MS=180000

# ─── Horizon cursor persistence ───────────────────────────────────────────────
# Path to the file where the Horizon SSE cursor is persisted across restarts.
# The cursor ensures payments that arrive during server downtime are not missed.
# Default: horizon-cursor.txt in the project root.
# For production deployments, point this to a persistent volume (e.g. /var/data/horizon-cursor.txt on Render).
# CURSOR_FILE=./horizon-cursor.txt
